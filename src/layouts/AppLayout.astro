---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Skill Atlas",
  description = "로컬 코딩 에이전트 스킬 인벤토리",
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#edf0f2" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
