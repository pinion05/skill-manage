{
  "name": "skill-manage",
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/fix-build-paths.mjs",
    "preview": "astro preview",
    "start": "node ./scripts/start.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run test && npm run check && npm run build",
    "prepack": "npm run verify",
    "smoke:package": "node ./scripts/smoke-package.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.0.2",
    "@astrojs/solid-js": "7.0.1",
    "ag-grid-community": "^32.3.9",
    "astro": "7.1.1",
    "gpt-tokenizer": "^3.4.0",
    "gray-matter": "4.0.3",
    "marked": "18.0.6",
    "sanitize-html": "2.17.6",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "26.1.1",
    "@types/sanitize-html": "2.16.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "description": "Local coding-agent Skill inventory and source atlas",
  "license": "MIT",
  "bin": {
    "skill-manage": "bin/skill-manage.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinion05/skill-manage.git"
  },
  "homepage": "https://github.com/pinion05/skill-manage#readme",
  "bugs": {
    "url": "https://github.com/pinion05/skill-manage/issues"
  },
  "keywords": [
    "agent-skills",
    "coding-agents",
    "skill-inventory",
    "astro",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  }
}
